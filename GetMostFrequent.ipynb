   "source": [
    "from collections import Counter"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "a083f022",
   "metadata": {},
   "outputs": [],
   "source": [
    "def GetMostFrequent(nums: list[int]):\n",
    "    if not nums:\n",
    "        return None\n",
    "    counter = Counter(nums).most_common(1)[0][0]\n",
    "    return counter"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 23,
   "id": "fe65aa22",
   "metadata": {},
   "outputs": [],
   "source": [
    "counter = GetMostFrequent([])\n",
