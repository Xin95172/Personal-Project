import pandas as pd
import numpy as np
import io
from google.colab import files

# 1. 上傳你的作業 Excel 檔
print("👉 請上傳你的作業 Excel 檔 (Index_你的學號_2023_Final)：")
uploaded = files.upload()
file_name = list(uploaded.keys())[0]
df = pd.read_excel(io.BytesIO(uploaded[file_name]))

# 2. 設定 Rf 邏輯 (一年期 1.44 基準)
# 根據你的 CSV 檔案與 3/24 升息邏輯：
# 3/24 之前 = 1.44% (0.0144)
# 3/24 之後 = 1.565% (0.01565)

df['Date_dt'] = pd.to_datetime(df['Date'])
df['Rf'] = np.where(df['Date_dt'] < '2023-03-24', 0.0144, 0.01565)

# 3. 整理欄位格式
target_cols = ['Date', 'File', 'S0', 'Maturity', 'Contract', 'ContractExpiryDate', 'Rf']
df_final = df[target_cols]

# 4. 存檔輸出
output_name = 'Index_2023_一年期1.44版.xlsx'
df_final.to_excel(output_name, index=False)

print(f"\n✅ 已經完全依照你的指示修改：")
print(f"1/3 的 Rf 為 0.0144 (一年期基準)")
print(f"3/24 之後的 Rf 為 0.01565 (升息後基準)")
print(f"👉 請下載檔案：{output_name}")