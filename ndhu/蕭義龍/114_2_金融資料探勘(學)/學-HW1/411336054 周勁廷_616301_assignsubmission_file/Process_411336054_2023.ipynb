import pandas as pd
import datetime
from dateutil.relativedelta import relativedelta

# --- 1. 讀取並清理原始資料 ---
# 讀取你的 TEJ 原始 CSV 檔 (跳過可能造成干擾的表頭，直接指定欄位名稱)
file_path = '202604071.csv'
df = pd.read_csv(file_path, header=None, names=['Date', 'SO'], skiprows=1)

# 清理 Date 欄位：轉為 datetime 格式，並剔除無法轉換的無效列（例如 TEJ 的標題說明）
df['Date'] = pd.to_datetime(df['Date'], errors='coerce')
df = df.dropna(subset=['Date'])

# 清理 SO 欄位：移除千分位逗號，並轉為浮點數
df['SO'] = df['SO'].astype(str).str.replace(',', '').astype(float)

# 確保資料按日期由舊到新排序
df = df.sort_values('Date').reset_index(drop=True)

# --- 2. 建立 File 欄位 ---
# 格式為 OptionsDaily_YYYY_MM_DD.csv
df['File'] = df['Date'].dt.strftime('OptionsDaily_%Y_%m_%d.csv')

# --- 3. 定義計算結算日（第三個星期三）的函數 ---
def get_3rd_wednesday(year, month):
    # 取得當月 1 號
    d = datetime.date(year, month, 1)
    # 找到當月第一個星期三 (weekday() == 2 代表星期三)
    offset = (2 - d.weekday()) % 7
    first_wed = d + datetime.timedelta(days=offset)
    # 加上 14 天即為第三個星期三
    third_wed = first_wed + datetime.timedelta(days=14)
    return third_wed

def get_contract_info(date_val):
    y, m = date_val.year, date_val.month
    expiry_date = get_3rd_wednesday(y, m)
    
    # 如果當天日期已經「超過」當月的結算日，契約就要換成「次月」
    if date_val.date() > expiry_date:
        next_month = date_val + relativedelta(months=1)
        y, m = next_month.year, next_month.month
        expiry_date = get_3rd_wednesday(y, m)
        
    contract_str = f"{y}{m:02d}"
    return pd.Series([contract_str, pd.to_datetime(expiry_date)])

# --- 4. 建立 Contract 與 ContractExpiry Date ---
df[['Contract', 'ContractExpiry Date']] = df['Date'].apply(get_contract_info)

# --- 5. 計算 Maturity ---
# 計算「到期日 - 交易日」的日曆天數差
df['Maturity'] = (df['ContractExpiry Date'] - df['Date']).dt.days

# --- 6. 整理日期輸出格式 ---
# 將 Date 和 ContractExpiry Date 轉回 YYYY-MM-DD 的字串格式
df['Date'] = df['Date'].dt.strftime('%Y-%m-%d')
df['ContractExpiry Date'] = df['ContractExpiry Date'].dt.strftime('%Y-%m-%d')

# --- 7. 處理 Rf (無風險利率) ---
# 註：目前的 CSV 檔中沒有 Rf 資料。在此先建立空欄位或預設值。
# 實務上你需讀取 Rf 的資料檔並用 pd.merge() 進行合併。
df['Rf'] = "請在此合併Rf資料" 

# --- 8. 調整欄位順序並輸出 ---
# 依照 PDF 作業規範的順序排列
final_columns = ['Date', 'File', 'SO', 'Contract', 'ContractExpiry Date', 'Maturity', 'Rf']
df_final = df[final_columns]

# 顯示前 10 筆資料檢核
print(df_final.head(10))

# 輸出成符合規範的一年份索引檔
df_final.to_excel('Index_你的學號_2023.xlsx', index=False)
print("\n轉換完成！已儲存為 Index_你的學號_2023.xlsx")

