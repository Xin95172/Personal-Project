; VirMixer Virtual Audio -- development driver, derived from Microsoft SysVAD.
[Version]
Signature="$WINDOWS NT$"
Class=MEDIA
ClassGuid={4d36e96c-e325-11ce-bfc1-08002be10318}
Provider=%Provider%
DriverVer=09/16/2026,0.1.0.0
CatalogFile=VirMixerAudio.cat
PnpLockDown=1

[Manufacturer]
%Provider%=Models,NTamd64.10.0...22000
[Models.NTamd64.10.0...22000]
%DeviceDesc%=VirMixer,Root\VirMixerAudio

[SourceDisksNames]
1=%DiskName%,,,
[SourceDisksFiles]
VirMixerAudio.sys=1
[DestinationDirs]
DriverCopy=13
[DriverCopy]
VirMixerAudio.sys

[VirMixer.NT]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration,WDMAUDIO.Registration
CopyFiles=DriverCopy
AddReg=DeviceReg

[DeviceReg]
HKR,MediaCategories\{058cf48c-8958-4b7e-9614-b3a10e9d66b7},Name,,%RenderName%
HKR,MediaCategories\{f63c1cf1-5e27-4c45-9ab3-a6124ab8f177},Name,,%CaptureName%

[VirMixer.NT.Services]
AddService=VirMixerAudio,0x00000002,DriverService
[DriverService]
DisplayName=%DeviceDesc%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\VirMixerAudio.sys

[VirMixer.NT.Wdf]
KmdfService=VirMixerAudio,WdfSection
[WdfSection]
KmdfLibraryVersion=$KMDFVERSION$

[VirMixer.NT.HW]
AddReg=HardwareReg
[HardwareReg]
HKR,,DeviceType,0x10001,0x1d
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GRGWGX;;;BA)(A;;GRGWGX;;;WD)(A;;GRGWGX;;;RC)"

[VirMixer.NT.Interfaces]
AddInterface=%Audio%,WaveSpdif,RenderWave
AddInterface=%Render%,WaveSpdif,RenderWave
AddInterface=%Realtime%,WaveSpdif,RenderWave
AddInterface=%Audio%,TopologySpdif,RenderTopology
AddInterface=%Topology%,TopologySpdif,RenderTopology
AddInterface=%Audio%,WaveMicIn,CaptureWave
AddInterface=%Capture%,WaveMicIn,CaptureWave
AddInterface=%Realtime%,WaveMicIn,CaptureWave
AddInterface=%Audio%,TopologyMicIn,CaptureTopology
AddInterface=%Topology%,TopologyMicIn,CaptureTopology

[RenderWave]
AddReg=RenderWaveReg
[RenderWaveReg]
HKR,,CLSID,,%Proxy%
HKR,,FriendlyName,,%RenderName%
[RenderTopology]
AddReg=RenderTopologyReg
[RenderTopologyReg]
HKR,,CLSID,,%Proxy%
HKR,,FriendlyName,,%RenderName%
HKR,EP\0,%Association%,,%AnyNode%
HKR,EP\0,%EventDriven%,0x10001,1

[CaptureWave]
AddReg=CaptureWaveReg
[CaptureWaveReg]
HKR,,CLSID,,%Proxy%
HKR,,FriendlyName,,%CaptureName%
[CaptureTopology]
AddReg=CaptureTopologyReg
[CaptureTopologyReg]
HKR,,CLSID,,%Proxy%
HKR,,FriendlyName,,%CaptureName%
HKR,EP\0,%Association%,,%AnyNode%
HKR,EP\0,%EventDriven%,0x10001,1

[Strings]
Provider="VirMixer Project"
DeviceDesc="VirMixer Virtual Audio"
DiskName="VirMixer Virtual Audio Driver"
RenderName="VirMixer Input"
CaptureName="VirMixer Output"
Proxy="{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
Audio="{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
Render="{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
Capture="{65E8773D-8F56-11D0-A3B9-00A0C9223196}"
Realtime="{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
Topology="{DDA54A40-1E4C-11D1-A050-405705C10000}"
Association="{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},2"
EventDriven="{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},7"
AnyNode="{00000000-0000-0000-0000-000000000000}"
